# Paystack — server-only. This key also signs incoming webhooks (Paystack has
# no separate webhook secret), so it must NEVER be prefixed with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL=

# NextAuth v5 (Auth.js)
AUTH_SECRET=          # generate with: openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@yourdomain.com
