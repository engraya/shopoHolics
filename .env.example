# ---------------------------------------------------------------------------
# Shopoholics — environment variables
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored).
# ---------------------------------------------------------------------------

# Postgres connection string (Neon serverless in production).
DATABASE_URL="postgresql://user:password@host:5432/shopoholics"

# NextAuth v5 session secret. Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Public base URL, used to build Paystack callbacks and email links.
# No trailing slash. Locally: http://localhost:3000
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Paystack secret key (test key starts with sk_test_). Server-side only —
# also used to verify webhook HMAC signatures.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# Google OAuth (optional — enables "Sign in with Google").
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend transactional email (order confirmations, welcome emails).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Shopoholics <orders@yourdomain.com>"
